GOOGLE_CLOUD_PROJECT=
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_TTS_LANGUAGE_CODE=en-US
GOOGLE_TTS_VOICE=en-US-Neural2-F
# Vercel production: use keyless Workload Identity Federation (not a JSON key).
GCP_PROJECT_ID=
GCP_PROJECT_NUMBER=
GCP_SERVICE_ACCOUNT_EMAIL=
GCP_WORKLOAD_IDENTITY_POOL_ID=vercel
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=vercel
# Must match the allowed audience configured on the Google OIDC provider.
GCP_AUDIENCE=https://vercel.com/YOUR_TEAM_SLUG
BLOB_READ_WRITE_TOKEN=
TTS_CACHE_PROVIDER=vercel-blob
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
TTS_RATE_LIMIT_PER_MINUTE=20
